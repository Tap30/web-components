{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "Tap30/web-components"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [["@tapsioss/icons", "@tapsioss/react-icons"]],
  "access": "public",
  "baseBranch": "main",
  "bumpVersionsWithWorkspaceProtocolOnly": true,
  "prettier": false,
  "updateInternalDependencies": "patch",
  "ignore": [
    "@internals/*",
    "@tapsioss/docs",
    "@tapsioss/lit-playground",
    "@tapsioss/react-playground",
    "@tapsioss/react-storybook",
    "@tapsioss/web-components",
    "@tapsioss/react-components",
    "@tapsioss/web-icons"
  ]
}
