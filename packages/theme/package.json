{
  "name": "@tapsioss/theme",
  "description": "Design tokens for the Tapsi Design System, as composable CSS and TypeScript layers.",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "./dist",
    "./README.md"
  ],
  "homepage": "https://tap30.github.io/web-components",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tap30/web-components.git",
    "directory": "packages/theme"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clear": "shx rm -rf dist",
    "check": "tsx ./scripts/check.ts",
    "prebuild": "run-s clear check",
    "build:transpile": "tsc --project tsconfig.build.json",
    "build:copy-css": "tsx ./scripts/copy-css-vars.ts",
    "build": "run-s build:transpile build:copy-css"
  },
  "dependencies": {
    "tslib": "^2.8.0"
  }
}
