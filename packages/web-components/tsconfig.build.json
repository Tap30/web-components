{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./dist"
  },
  "include": ["src"],
  // Re-declared: replaces the root's `exclude`, which lists this archived
  // directory and would otherwise match these inputs too.
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "__tests__"
  ]
}
