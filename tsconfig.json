{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ES2020",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "incremental": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "jsx": "react-jsx",

    "strict": true,
    "pretty": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rewriteRelativeImportExtensions": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "importHelpers": true,

    "paths": {
      // Icons metadata
      "@tapsioss/icons": [
        "./packages/icons/dist",
        "./types/@tapsioss/icons.ts"
      ],
      // Web Component Icons
      "@tapsioss/web-icons": ["./packages/web-icons/dist"],
      "@tapsioss/web-icons/*": ["./packages/web-icons/dist/*"],
      // React Icons
      "@tapsioss/react-icons": ["./packages/react-icons/dist"],
      "@tapsioss/react-icons/*": ["./packages/react-icons/dist/*"],
      // Web Components
      "@tapsioss/web-components": [
        "./packages/web-components/dist",
        "./packages/web-components/src"
      ],
      "@tapsioss/web-components/*": [
        "./packages/web-components/dist/*",
        "./packages/web-components/src/*"
      ],
      // React Components
      "@tapsioss/react-components": [
        "./packages/react-components/dist",
        "./packages/react-components/src"
      ],
      "@tapsioss/react-components/*": [
        "./packages/react-components/dist/*",
        "./packages/react-components/src/*"
      ],
      // React UI (built on Base UI). `dist` first, matching every other package
      // here — so the playground and any consumer exercise the built artifact.
      // Storybook deliberately overrides this to `src` in its own tsconfig, to
      // keep its dev loop on source with no rebuild.
      "@tapsioss/react-ui": [
        "./packages/react-ui/dist",
        "./packages/react-ui/src"
      ],
      "@tapsioss/react-ui/*": [
        "./packages/react-ui/dist/*",
        "./packages/react-ui/src/*"
      ],
      // Tokens
      "@tapsioss/theme/*/css-variables": ["./packages/theme/src/*/tokens.css"],
      "@tapsioss/theme/css-variables": [
        "./packages/theme/src/default-theme/tokens.css"
      ],
      "@tapsioss/theme/*/tokens": ["./packages/theme/src/*/tokens.ts"],
      "@tapsioss/theme/tokens": [
        "./packages/theme/src/default-theme/tokens.ts"
      ],
      "@tapsioss/theme/types": ["./packages/theme/src/types.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "docs/.vitepress/**/*.ts"],
  // Stories import Storybook's types, which are exports-map-only ESM and so are
  // unresolvable under this config's `moduleResolution: "node"` (Node10). They
  // are type-checked instead by their own package's tsconfig, which overrides
  // the resolver — see packages/react-ui/tsconfig.json.
  "exclude": ["node_modules", "dist", "**/*.stories.ts", "**/*.stories.tsx"]
}
